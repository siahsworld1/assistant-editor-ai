# Copy this file to .env (same folder) and fill in real keys.
# .env is already covered by the parent project's .gitignore pattern for env files —
# double check before committing anything in worker/.

# Required for transcription (Whisper API).
OPENAI_API_KEY=

# Required for visual analysis + selects/stories/build reasoning.
ANTHROPIC_API_KEY=

# Optional: override the Claude model used for reasoning/vision.
# ASSISTANT_EDITOR_CLAUDE_MODEL=claude-sonnet-4-5
