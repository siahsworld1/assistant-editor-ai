# Copy this file to .env (same folder) and fill in real keys.
# .env is already covered by the parent project's .gitignore pattern for env files —
# double check before committing anything in worker/.

# --- Provider selection --------------------------------------------------
# Assistant Editor AI is a model-agnostic orchestration platform: the AI vendor
# behind transcription and behind editorial reasoning is a config choice, not a
# hardcoded dependency. See worker/providers/registry.py for the full list of
# available providers and worker/providers/base.py for the interfaces every
# provider implements.

# Which vendor transcribes audio. Currently only "openai" (Whisper) is built in —
# Anthropic has no ASR product. Default: openai
# ASSISTANT_EDITOR_TRANSCRIPTION_PROVIDER=openai

# Which vendor does vision + editorial reasoning (frame descriptions, selects,
# stories, timeline building). Options: "anthropic" (Claude) or "openai" (GPT-4o).
# Default: anthropic
# ASSISTANT_EDITOR_REASONING_PROVIDER=anthropic

# --- Vendor credentials ---------------------------------------------------
# Only the key(s) for your selected provider(s) are required. With the defaults
# above, both are needed.

# Required if ASSISTANT_EDITOR_TRANSCRIPTION_PROVIDER=openai (the default), and/or
# if ASSISTANT_EDITOR_REASONING_PROVIDER=openai.
OPENAI_API_KEY=

# Required if ASSISTANT_EDITOR_REASONING_PROVIDER=anthropic (the default).
ANTHROPIC_API_KEY=

# --- Model overrides -------------------------------------------------------
# Optional: override the specific model used by each reasoning provider.
# ASSISTANT_EDITOR_CLAUDE_MODEL=claude-sonnet-4-5
# ASSISTANT_EDITOR_OPENAI_MODEL=gpt-4o
