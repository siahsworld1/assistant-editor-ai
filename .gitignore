# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Environment files — never commit real secrets. Root .env is read by Vite's
# built-in env loading; worker/.env by the Python worker. .env.example files
# are templates (no real values) and are intentionally NOT ignored.
.env
.env.local
.env.*.local

# Python worker
worker/__pycache__/
worker/**/__pycache__/
worker/.venv/
worker/.env

# Local end-to-end validation output (worker/validate_e2e.py): real exported
# .edl/.xml/.fcpxml, the fixture (contains real local file paths), and the
# JSON report — none of this is meant to be committed, it's regenerated by
# running the validator against your own footage.
worker/validation-output/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# desktop build output
release/
dist-desktop/
dist-premiere/
