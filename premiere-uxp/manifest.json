{
  "manifestVersion": 5,
  "id": "ai.assistanteditor.premiere",
  "name": "Assistant Editor AI",
  "version": "0.4.0",
  "main": "index.html",
  "host": [
    {
      "app": "premierepro",
      "minVersion": "25.0.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "assistantEditorPanel",
      "label": { "default": "Assistant Editor AI" },
      "minimumSize": { "width": 320, "height": 420 },
      "preferredDockedSize": { "width": 360, "height": 640 },
      "preferredFloatingSize": { "width": 380, "height": 680 }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": ["http://127.0.0.1:32146"]
    },
    "localFileSystem": "plugin",
    "allowCodeGenerationFromStrings": false
  },
  "icons": []
}